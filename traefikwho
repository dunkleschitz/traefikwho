def _entrypoint_term(router, entrypoint):
    if router.entrypoints is None:
        return TRUE, [], None
    if entrypoint is None:
        return UNKNOWN, [
            "entrypoint UNKNOWN — router %s lists entrypoints %s "
            "(supply --entrypoint)" % (router.name,
                                       ", ".join(router.entrypoints))], \
            "--entrypoint"
    if entrypoint in router.entrypoints:
        return TRUE, [], None
    return FALSE, [
        "[entrypoint-excluded] router %s is not attached to entrypoint "
        "%s" % (router.name, entrypoint)], None


def _tls_term_http(router, facts, cfg):
    """TR18: router tls (or inherited entrypoint http.tls) makes the
    router HTTPS-only. Returns (value, reasons, missing_flag)."""
    if router.tls is not None:
        https_only = True
    else:
        eps = router.entrypoints
        if facts.entrypoint is not None:
            ep = cfg.static.entrypoints.get(facts.entrypoint, {})
            https_only = bool(
                isinstance(ep.get("http"), dict)
                and ep["http"].get("tls") is not None)
        elif eps is not None:
            states = []
            for name in eps:
                ep = cfg.static.entrypoints.get(name, {})
                states.append(bool(
                    isinstance(ep.get("http"), dict)
                    and ep["http"].get("tls") is not None))
            if states and all(states):
                https_only = True
            elif states and not any(states):
                https_only = False
            elif states:
                return UNKNOWN, [
                    "TLS scope UNKNOWN — entrypoints %s disagree on "
                    "http.tls (supply --entrypoint)"
                    % ", ".join(eps)], "--entrypoint"
            else:
                https_only = False
        else:
            # attached to all entrypoints: HTTPS-only only if every
            # known entrypoint has TLS; unknown without --static.
            if not cfg.static.file:
                return TRUE, [], None
            states = [bool(isinstance(ep.get("http"), dict)
                           and ep["http"].get("tls") is not None)
                      for ep in cfg.static.entrypoints.values()]
            if states and all(states):
                https_only = True
            elif states and not any(states):
                https_only = False
            elif states:
                return UNKNOWN, [
                    "TLS scope UNKNOWN — entrypoints disagree on "
                    "http.tls (supply --entrypoint)"], "--entrypoint"
            else:
                https_only = False
    if not https_only:
        return TRUE, [], None
    if facts.tls is TRUE:
        return TRUE, [], None
    if facts.tls is FALSE:
        return FALSE, [
            "TLS scope FALSE — router %s is HTTPS-only but the request "
            "is plain HTTP (--no-tls)" % router.name], None
    return UNKNOWN, [
        "TLS scope UNKNOWN — router %s is HTTPS-only (supply --tls or "
        "--no-tls)" % router.name], "--tls"


def _tls_term_tcp(router, facts):
    """A TCP router with a tls block only handles TLS connections."""
    if router.tls is None:
        return TRUE, [], None
    if facts.tls is TRUE:
        return TRUE, [], None
    if facts.tls is FALSE:
        return FALSE, [
            "TLS scope FALSE — TCP router %s terminates TLS but the "
            "connection is plain (--no-tls)" % router.name], None
    return UNKNOWN, [
        "TLS scope UNKNOWN — TCP router %s terminates TLS (supply "
        "--tls or --no-tls)" % router.name], "--tls"


def evaluate_router(router, facts, cfg):
    """Evaluate entrypoint + TLS + rule terms (Kleene AND).
    Returns (value, deciding_reasons, missing_flags)."""
    if router.templated or router.ast is None:
        return UNKNOWN, [
            "[go-template-not-evaluated] router %s comes from a file "
            "containing Go templates; its rule is unknown"
            % router.name], []
    ep_val, ep_reasons, ep_flag = _entrypoint_term(router,
                                                   facts.entrypoint)
    if router.kind == "http":
        tls_val, tls_reasons, tls_flag = _tls_term_http(router, facts, cfg)
    else:
        tls_val, tls_reasons, tls_flag = _tls_term_tcp(router, facts)
    facts.router_has_tls = router.tls is not None
    rule_val, rule_reasons = eval_rule(router.ast, facts, router.compiled,
                                       router.kind, router.where)
    val = TRUE
    for v in (ep_val, tls_val, rule_val):
        if v is FALSE:
            val = FALSE
            break
        if v is UNKNOWN:
            val = UNKNOWN
    flags = [f for f in (ep_flag, tls_flag) if f]
    if val is FALSE:
        reasons = []
        if ep_val is FALSE:
            reasons += ep_reasons
        if tls_val is FALSE:
            reasons += tls_reasons
        if rule_val is FALSE:
            reasons += rule_reasons
        return FALSE, reasons, flags
    if val is UNKNOWN:
        reasons = []
        if ep_val is UNKNOWN:
            reasons += ep_reasons
        if tls_val is UNKNOWN:
            reasons += tls_reasons
        if rule_val is UNKNOWN:
            reasons += rule_reasons
        for fl in missing_flags_for(router.ast, facts, router.compiled,
                                    router.kind, router.where):
            if fl not in flags:
                flags.append(fl)
        return UNKNOWN, reasons, flags
    return TRUE, rule_reasons, flags


def _resolve_tr13(evaluated, cfg):
    """TR13/TR14: sort TRUE by priority desc, name asc; an UNKNOWN
    router that could outrank the best TRUE router blocks.
    evaluated: list of dicts {router, value, reasons, flags}.
    Returns (status, winner_or_None, blockers)."""
    trues = [e for e in evaluated if e["value"] is TRUE]
    unknowns = [e for e in evaluated if e["value"] is UNKNOWN]
    if trues:
        trues.sort(key=lambda e: (-e["router"].priority, e["router"].name))
        best = trues[0]
        blockers = [e for e in unknowns
                    if e["router"].priority is not None
                    and e["router"].priority >= best["router"].priority]
        if blockers:
            return "unknown", None, blockers
        tie = [e for e in trues[1:]
               if e["router"].priority == best["router"].priority]
        if tie:
            cfg.findings.append(
                "[same-priority-tie-name-order] routers %s and %s share "
                "priority %d; the tie is broken by router name ascending "
                "[hypothesized]"
                % (best["router"].name, tie[0]["router"].name,
                   best["router"].priority))
        return "match", best, []
    if unknowns:
        return "unknown", None, unknowns
    return "no-match", None, []


def _multi_layer_candidates(cfg, facts, kind):
    """TR24: excluded child routers whose rule evaluates TRUE (or
    UNKNOWN) against the raw request, with the parent chain present."""
    out = []
    for r in cfg.router_by_kind(kind).values():
        if not r.parent_refs or r.templated or r.ast is None:
            continue
        parents_present = all(
            p in cfg.router_by_kind(kind) for p in r.parent_refs)
        if not parents_present:
            continue
        val, _reasons, _flags = evaluate_router(r, facts, cfg)
        if val is not FALSE:
            out.append(r)
    return out


def _tcp_gate(cfg, facts):
    """TR16: for the http verb, does a TCP router on the entrypoint
    evaluate TRUE or UNKNOWN on the available connection facts?
    Returns the blocking router entry or None."""
    for r in cfg.tcp_routers.values():
        if r.parent_refs or r.templated:
            continue
        ep_val, _er, _f = _entrypoint_term(r, facts.entrypoint)
        if ep_val is FALSE:
            continue
        if r.ast is None:
            continue
        facts.router_has_tls = r.tls is not None
        rule_val, _rr = eval_rule(r.ast, facts, r.compiled, "tcp",
                                  r.where)
        tls_val, _tr, _tf = _tls_term_tcp(r, facts)
        val = _kleene_and(_kleene_and(ep_val, tls_val), rule_val)
        if val is not FALSE:
            return {"router": r, "value": val}
    return None


def _redirect_check(cfg, facts):
    """TR20: entrypoint redirection in --static. Returns a redirect
    dict or None. The ACME challenge path is exempt."""
    if not cfg.static.file or facts.entrypoint is None:
        return None
    ep = cfg.static.entrypoints.get(facts.entrypoint)
    if not isinstance(ep, dict):
        return None
    http = ep.get("http")
    if not isinstance(http, dict):
        return None
    redir = http.get("redirections")
    if not isinstance(redir, dict):
        return None
    entry = redir.get("entryPoint")
    if not isinstance(entry, dict):
        return None
    if isinstance(facts, HttpFacts) and \
            facts.path.startswith("/.well-known/acme-challenge/"):
        return None
    target = entry.get("to")
    scheme = entry.get("scheme", "https")
    permanent = entry.get("permanent", True)
    return {"entrypoint": facts.entrypoint, "target": target,
            "scheme": scheme,
            "status": 301 if permanent else 302}


def _build_verdict_base(cfg, facts, kind):
    """Shared coverage/findings block for every verdict."""
    coverage = {
        "provider": "file",
        "files_read": [p for p, _k in cfg.files],
        "files_ignored": [{"path": p, "reason": r}
                          for p, r in cfg.ignored_files],
        "routers": len(cfg.all_routers()),
        "http_routers": len(cfg.http_routers),
        "tcp_routers": len(cfg.tcp_routers),
        "udp_routers": len(cfg.udp_routers),
        "services": len(cfg.services),
        "middlewares": len(cfg.middlewares),
        "tls_options": len(cfg.tls_options),
        "static_supplied": bool(cfg.static.file),
        "static_file": cfg.static.file,
        "pinned_traefik": PINNED_TRAEFIK,
    }
    return coverage


def _winner_detail(cfg, router, facts, kind):
    """Resolve the winner's service + middleware chains. Returns
    (detail_dict, cross_ref_or_None, banners)."""
    detail = {"router": router, "banners": []}
    status, payload = resolve_service_ref(cfg, router.service_ref,
                                          kind, router.where)
    if status == "cross":
        return None, ("service %s references provider %r (out of scope)"
                      % (router.service_ref, payload)), []
    if status == "missing":
        return None, ("service %s is not defined" % router.service_ref), []
    if status == "internal":
        detail["service"] = {"name": payload, "kind": kind,
                             "provider": "internal", "type": "internal",
                             "banners": [], "servers": [], "members": [],
                             "has_servers": True, "effective": None}
    else:
        svc = payload
        detail["service"] = service_servers(cfg, svc)
        detail["service"]["provider"] = "file"
    # middleware chains: router first, then service (v3.7, TR23)
    chain, cross = expand_chain(cfg, router.middleware_refs, router.where)
    if cross is not None:
        return None, ("middleware %s references a non-file provider "
                      "(out of scope)" % cross), []
    detail["router_chain"] = chain
    svc_chain = []
    if status == "file":
        svc_chain, cross = expand_chain(cfg, payload.middlewares,
                                        payload.where)
        if cross is not None:
            return None, ("service middleware %s references a non-file "
                          "provider (out of scope)" % cross), []
    detail["service_chain"] = svc_chain
    # TLS mode annotation (TR17/TR18)
    if kind == "tcp":
        if router.tls is None:
            detail["tls_mode"] = "none"
        elif router.tls.get("passthrough"):
            detail["tls_mode"] = "passthrough"
            detail["banners"].append(
                "[passthrough-cert-backend] TLS is passed through "
                "untouched; whether the backend's certificate matches "
                "the SNI is a backend fact")
        else:
            detail["tls_mode"] = "terminate"
    else:
        if router.tls is not None:
            detail["tls_mode"] = "router-tls"
        else:
            detail["tls_mode"] = "none"
    # path rewriting (TR22)
    full_chain = chain + svc_chain
    if isinstance(facts, HttpFacts):
        final_path, steps = apply_rewrites(full_chain, facts.path)
        detail["rewritten_path"] = final_path
        detail["rewrite_steps"] = steps
    else:
        detail["rewritten_path"] = None
        detail["rewrite_steps"] = []
    # middleware outcome annotations
    for mw in full_chain:
        cls = classify_middleware(mw)
        if mw.type in ("BasicAuth", "DigestAuth", "ForwardAuth"):
            detail["banners"].append(
                "[auth-may-reject] %s middleware %s may reject the "
                "request (credentials not evaluated)" % (mw.type, mw.name))
        if mw.type in ("RateLimit", "InFlightReq"):
            detail["banners"].append(
                "[rate-limit-runtime] %s middleware %s is "
                "capacity-dependent (runtime)" % (mw.type, mw.name))
        if mw.type == "CircuitBreaker":
            detail["banners"].append(
                "[circuit-breaker-runtime] CircuitBreaker %s is "
                "health-dependent (runtime)" % mw.name)
        if mw.type == "IPAllowList":
            ranges = mw.config.get("sourceRange") or []
            if facts.client_ip is not None and ranges:
                nets = []
                try:
                    nets = [ipaddress.ip_network(str(x), strict=False)
                            for x in ranges]
                except ValueError:
                    nets = []
                if nets and _ip_in_networks(facts.client_ip,
                                            nets) is FALSE:
                    detail["banners"].append(
                        "[ipallowlist-would-reject] client IP %s is "
                        "outside IPAllowList %s sourceRange"
                        % (facts.client_ip_raw, mw.name))
        if mw.type in ("RedirectScheme", "RedirectRegex"):
            detail["banners"].append(
                "[redirect-middleware] %s middleware %s redirects the "
                "client before the service is reached"
                % (mw.type, mw.name))
        if mw.type in V38_ONLY_MIDDLEWARES:
            detail["banners"].append(
                "[v3.8-only] middleware %s is type Tap (v3.8 feature)"
                % mw.name)
        if mw.type not in HTTP_BUILTIN_MIDDLEWARES and \
                mw.type not in TCP_BUILTIN_MIDDLEWARES and \
                mw.type not in V38_ONLY_MIDDLEWARES:
            detail["banners"].append(
                "[unknown-middleware-type] middleware %s (type %s) is "
                "opaque; its effect is unknown" % (mw.name, mw.type))
    # service banners propagate
    if status == "file":
        detail["banners"] += detail["service"]["banners"]
        if not detail["service"]["has_servers"]:
            detail["banners"].append(
                "[service-has-no-servers] the live answer would be 503")
    # default-cert annotation (TR18)
    if kind == "http" and router.tls is not None:
        has_cert = bool(cfg.tls_certs) or bool(cfg.static.has_tls_certs) \
            or bool(router.tls.get("certResolver"))
        if not has_cert:
            detail["banners"].append(
                "[default-cert-would-serve] winning TLS router has no "
                "certificate source in the config; Traefik would serve "
                "its default self-signed certificate")
    if router.tls and router.tls.get("certResolver"):
        detail["banners"].append(
            "[acme-cert-runtime] certResolver %r: certificate issuance "
            "state is runtime" % router.tls.get("certResolver"))
    if router.tls and router.tls.get("options"):
        opt = cfg.tls_options.get(router.tls["options"])
        if opt and isinstance(opt.data.get("clientAuth"), dict):
            detail["banners"].append(
                "[client-auth-required] TLS options %s demand a client "
                "certificate; the handshake may fail after routing"
                % router.tls["options"])
    # catch-all converting 404 to 503 (TR19)
    if status == "file" and not detail["service"]["has_servers"]:
        if router.rule and router.rule.strip() in (
                "Host(`*`)", "HostSNI(`*`)"):
            detail["banners"].append(
                "[catchall-converts-404-to-503] catch-all router to a "
                "serverless service converts 404s into 503s")
    return detail, None, detail["banners"]


def http_verdict(cfg, facts):
    """The full http-verb walk (TR13/TR15/TR16/TR18/TR19/TR20/TR24)."""
    coverage = _build_verdict_base(cfg, facts, "http")
    redir = _redirect_check(cfg, facts)
    if redir is not None:
        return {"verdict": "REDIRECT", "exit": 0, "redirect": redir,
                "router": None, "service": None, "match_chain": [],
                "findings": list(cfg.findings) + list(
                    cfg.duplicate_findings) + list(cfg.shadow_findings),
                "coverage": coverage, "blockers": [], "tcp_gate": None}
    evaluated = []
    for r in cfg.http_routers.values():
        if r.parent_refs or r.templated:
            continue
        val, reasons, flags = evaluate_router(r, facts, cfg)
        evaluated.append({"router": r, "value": val, "reasons": reasons,
                          "flags": flags})
    evaluated.sort(key=lambda e: (-(e["router"].priority or 0),
                                  e["router"].name))
    # TCP-before-HTTP gate (TR16)
    gate = _tcp_gate(cfg, facts)
    if gate is not None:
        blocker = {"router": gate["router"], "value": gate["value"],
                   "reasons": ["[tcp-router-may-claim-connection] TCP "
                               "router %s (%s) on this entrypoint may "
                               "claim the connection before HTTP routers "
                               "see it" % (gate["router"].name,
                                            gate["router"].where)],
                   "flags": []}
        return {"verdict": "UNKNOWN", "exit": 2, "router": None,
                "service": None, "match_chain": evaluated,
                "findings": list(cfg.findings) + list(
                    cfg.duplicate_findings) + list(cfg.shadow_findings),
                "coverage": coverage, "blockers": [blocker],
                "tcp_gate": blocker}
    # multi-layer candidates (TR24)
    ml = _multi_layer_candidates(cfg, facts, "http")
    if ml:
        blockers = [{"router": r, "value": UNKNOWN,
                     "reasons": ["[multi-layer-routing] router %s (%s) "
                                 "has parentRefs %s; its rule matches the "
                                 "raw request but child routing depends on "
                                 "parent middleware effects, which v1 does "
                                 "not simulate" % (r.name, r.where,
                                                   r.parent_refs)],
                     "flags": []} for r in ml]
        return {"verdict": "UNKNOWN", "exit": 2, "router": None,
                "service": None, "match_chain": evaluated,
                "findings": list(cfg.findings) + list(
                    cfg.duplicate_findings) + list(cfg.shadow_findings),
                "coverage": coverage, "blockers": blockers,
                "tcp_gate": None}
    status, winner, blockers = _resolve_tr13(evaluated, cfg)
    if status == "unknown":
        return {"verdict": "UNKNOWN", "exit": 2, "router": None,
                "service": None, "match_chain": evaluated,
                "findings": list(cfg.findings) + list(
                    cfg.duplicate_findings) + list(cfg.shadow_findings),
                "coverage": coverage, "blockers": blockers,
                "tcp_gate": None}
    if status == "no-match":
        templated = [r for r in cfg.http_routers.values() if r.templated]
        if templated:
            blockers = [{"router": r, "value": UNKNOWN,
                         "reasons": ["[go-template-not-evaluated] router "
                                     "%s (%s) comes from a templated file; "
                                     "it might have matched" % (r.name,
                                                                 r.where)],
                         "flags": []} for r in templated]
            return {"verdict": "UNKNOWN", "exit": 2, "router": None,
                    "service": None, "match_chain": evaluated,
                    "findings": list(cfg.findings) + list(
                        cfg.duplicate_findings) + list(cfg.shadow_findings),
                    "coverage": coverage, "blockers": blockers,
                    "tcp_gate": None}
        return {"verdict": "NO-MATCH", "exit": 1, "router": None,
                "service": None, "match_chain": evaluated,
                "findings": list(cfg.findings) + list(
                    cfg.duplicate_findings) + list(cfg.shadow_findings),
                "coverage": coverage, "blockers": [],
                "tcp_gate": None}
    detail, cross, _b = _winner_detail(cfg, winner["router"], facts, "http")
    if cross is not None:
        blocker = {"router": winner["router"], "value": UNKNOWN,
                   "reasons": ["[cross-provider-reference] " + cross],
                   "flags": []}
        return {"verdict": "UNKNOWN", "exit": 2, "router": None,
                "service": None, "match_chain": evaluated,
                "findings": list(cfg.findings) + list(
                    cfg.duplicate_findings) + list(cfg.shadow_findings),
                "coverage": coverage, "blockers": [blocker],
                "tcp_gate": None}
    return {"verdict": "MATCH", "exit": 0, "router": winner["router"],
            "service": detail["service"], "detail": detail,
            "match_chain": evaluated,
            "findings": list(cfg.findings) + list(
                cfg.duplicate_findings) + list(cfg.shadow_findings),
            "coverage": coverage, "blockers": [], "tcp_gate": None}


def tcp_verdict(cfg, facts):
    """The tcp-verb walk (TR16/TR17/TR32). No HTTP consultation."""
    coverage = _build_verdict_base(cfg, facts, "tcp")
    evaluated = []
    for r in cfg.tcp_routers.values():
        if r.parent_refs or r.templated:
            continue
        val, reasons, flags = evaluate_router(r, facts, cfg)
        evaluated.append({"router": r, "value": val, "reasons": reasons,
                          "flags": flags})
    evaluated.sort(key=lambda e: (-(e["router"].priority or 0),
                                  e["router"].name))
    ml = _multi_layer_candidates(cfg, facts, "tcp")
    if ml:
        blockers = [{"router": r, "value": UNKNOWN,
                     "reasons": ["[multi-layer-routing] router %s (%s) "
                                 "has parentRefs %s" % (r.name, r.where,
                                                         r.parent_refs)],
                     "flags": []} for r in ml]
        return {"verdict": "UNKNOWN", "exit": 2, "router": None,
                "service": None, "match_chain": evaluated,
                "findings": list(cfg.findings) + list(
                    cfg.duplicate_findings) + list(cfg.shadow_findings),
                "coverage": coverage, "blockers": blockers,
                "tcp_gate": None}
    status, winner, blockers = _resolve_tr13(evaluated, cfg)
    if status == "unknown":
        return {"verdict": "UNKNOWN", "exit": 2, "router": None,
                "service": None, "match_chain": evaluated,
                "findings": list(cfg.findings) + list(
                    cfg.duplicate_findings) + list(cfg.shadow_findings),
                "coverage": coverage, "blockers": blockers,
                "tcp_gate": None}
    if status == "no-match":
        templated = [r for r in cfg.tcp_routers.values() if r.templated]
        if templated:
            blockers = [{"router": r, "value": UNKNOWN,
                         "reasons": ["[go-template-not-evaluated] router "
                                     "%s (%s) comes from a templated file"
                                     % (r.name, r.where)],
                         "flags": []} for r in templated]
            return {"verdict": "UNKNOWN", "exit": 2, "router": None,
                    "service": None, "match_chain": evaluated,
                    "findings": list(cfg.findings) + list(
                        cfg.duplicate_findings) + list(cfg.shadow_findings),
                    "coverage": coverage, "blockers": blockers,
                    "tcp_gate": None}
        note = None
        if cfg.http_routers:
            note = ("[http-routers-may-claim] no TCP router matched; "
                    "HTTP routers may still claim the connection")
        return {"verdict": "NO-MATCH", "exit": 1, "router": None,
                "service": None, "match_chain": evaluated,
                "findings": list(cfg.findings) + list(
                    cfg.duplicate_findings) + list(cfg.shadow_findings)
                + ([note] if note else []),
                "coverage": coverage, "blockers": [],
                "tcp_gate": None}
    detail, cross, _b = _winner_detail(cfg, winner["router"], facts, "tcp")
    if cross is not None:
        blocker = {"router": winner["router"], "value": UNKNOWN,
                   "reasons": ["[cross-provider-reference] " + cross],
                   "flags": []}
        return {"verdict": "UNKNOWN", "exit": 2, "router": None,
                "service": None, "match_chain": evaluated,
                "findings": list(cfg.findings) + list(
                    cfg.duplicate_findings) + list(cfg.shadow_findings),
                "coverage": coverage, "blockers": [blocker],
                "tcp_gate": None}
    return {"verdict": "MATCH", "exit": 0, "router": winner["router"],
            "service": detail["service"], "detail": detail,
            "match_chain": evaluated,
            "findings": list(cfg.findings) + list(
                cfg.duplicate_findings) + list(cfg.shadow_findings),
            "coverage": coverage, "blockers": [], "tcp_gate": None}

# ---------------------------------------------------------------- render

def _router_label(router):
    if router.is_internal:
        return "%s@internal" % router.name
    return "%s@file" % router.name


def _value_word(value):
    if value is TRUE:
        return "TRUE"
    if value is FALSE:
        return "FALSE"
    return "UNKNOWN"


def _middleware_line(mw, chain_kind):
    return "    %s %s (%s) %s [%s]" % (
        chain_kind, mw.name, mw.type, mw.where, classify_middleware(mw))


def render_text(verdict, cfg, facts, quiet):
    out = []
    v = verdict["verdict"]
    if v == "REDIRECT":
        r = verdict["redirect"]
        out.append("VERDICT REDIRECT — entrypoint %s redirects to %s "
                   "(scheme %s, HTTP %d); no router evaluated"
                   % (r["entrypoint"], r["target"], r["scheme"],
                      r["status"]))
    elif v == "MATCH":
        router = verdict["router"]
        detail = verdict["detail"]
        svc = verdict["service"]
        out.append("VERDICT MATCH — router %s %s (priority %d) → "
                   "service %s"
                   % (_router_label(router), router.where,
                      router.priority,
                      "%s@%s" % (svc["name"],
                                  svc.get("provider", "file"))))
        out.append("  rule: %s" % router.rule)
        if isinstance(facts, HttpFacts) and facts.path_raw != facts.path:
            out.append("  path %s (normalized from %s)"
                       % (facts.path, facts.path_raw))
        if router.tls is not None and router.kind == "http":
            out.append("  tls: router-tls (HTTPS-only)")
        elif router.kind == "tcp":
            out.append("  tls=%s" % detail["tls_mode"])
        else:
            out.append("  tls: none")
        if svc["type"] == "internal":
            out.append("  service: %s@internal (Traefik internal service)"
                       % svc["name"])
        elif svc["type"] == "loadBalancer":
            servers = ", ".join(svc["servers"]) if svc["servers"] \
                else "(no servers)"
            out.append("  service: %s@file (loadBalancer) — servers: %s"
                       % (svc["name"], servers))
        elif svc["type"] == "weighted":
            members = ", ".join(
                "%s (weight %s)" % (m["ref"], m["weight"])
                for m in svc["members"])
            out.append("  service: %s@file (weighted) — members: %s"
                       % (svc["name"], members))
        elif svc["type"] == "mirroring":
            members = ", ".join(
                "%s%s" % (m["ref"],
                          (" (mirror, %s%%)" % m["percent"])
                          if m.get("role") == "mirror" else " (main)")
                for m in svc["members"])
            out.append("  service: %s@file (mirroring) — %s"
                       % (svc["name"], members))
        elif svc["type"] == "failover":
            members = ", ".join(
                "%s (%s)" % (m["ref"], m["role"]) for m in svc["members"])
            out.append("  service: %s@file (failover) — %s"
                       % (svc["name"], members))
        if svc.get("effective"):
            out.append("  effective service: %s" % svc["effective"])
        if detail["router_chain"] or detail["service_chain"]:
            out.append("  middlewares:")
            for mw in detail["router_chain"]:
                out.append(_middleware_line(mw, "router:"))
            for mw in detail["service_chain"]:
                out.append(_middleware_line(mw, "service:"))
            if detail["rewrite_steps"]:
                for mw, old, new in detail["rewrite_steps"]:
                    out.append("    path rewrite: %s %s → %s"
                               % (mw.name, old, new))
                out.append("  service sees path: %s"
                           % detail["rewritten_path"])
        for banner in detail["banners"]:
            out.append("  %s" % banner)
    elif v == "NO-MATCH":
        out.append("VERDICT NO-MATCH — no router matched (live answer: "
                   "404 Not Found)")
    else:  # UNKNOWN
        out.append("VERDICT UNKNOWN — the answer is not statically "
                   "decidable")
        for b in verdict["blockers"]:
            r = b["router"]
            out.append("  blocker: %s (%s) — %s"
                       % (r.name, r.where, "; ".join(b["reasons"])))
            if b.get("flags"):
                out.append("    resolve with: %s"
                           % ", ".join(b["flags"]))
    if quiet:
        return "\n".join(out[:1]) + "\n"
    if verdict["match_chain"]:
        out.append("  match chain (priority order):")
        for e in verdict["match_chain"]:
            r = e["router"]
            prio = r.priority if r.priority is not None else "?"
            out.append("    %s %s %s (priority %s) — %s"
                       % (_value_word(e["value"]), _router_label(r),
                          r.where, prio, "; ".join(e["reasons"])))
    if verdict["findings"]:
        out.append("  findings:")
        for f in verdict["findings"]:
            out.append("    %s" % f)
    cov = verdict["coverage"]
    out.append("  coverage:")
    out.append("    provider: file only "
               "[file-provider-only]")
    if cov["static_supplied"]:
        out.append("    static config: %s" % cov["static_file"])
    else:
        out.append("    static config: not supplied "
                   "[static-config-not-supplied] — entrypoint TLS, "
                   "redirections, defaultRuleSyntax, and other-provider "
                   "detection are unknown")
    out.append("    files read: %s"
               % (", ".join(cov["files_read"]) or "(none)"))
    for ign in cov["files_ignored"]:
        out.append("    ignored: %s (%s)" % (ign["path"], ign["reason"]))
    out.append("    inventoried: %d routers (%d http, %d tcp, %d udp), "
               "%d services, %d middlewares, %d tls.options"
               % (cov["routers"], cov["http_routers"], cov["tcp_routers"],
                  cov["udp_routers"], cov["services"], cov["middlewares"],
                  cov["tls_options"]))
    if cfg.static.file and not cfg.static.entrypoints:
        out.append("    entrypoints: none defined in static config "
                   "[entrypoint-properties-unknown]")
    elif cfg.static.file:
        out.append("    entrypoints: %s"
                   % ", ".join(sorted(cfg.static.entrypoints)))
    else:
        out.append("    entrypoints: unknown (no --static) "
                   "[entrypoint-properties-unknown]")
    if isinstance(facts, HttpFacts) and facts.path_raw != facts.path:
        out.append("    note: path normalized %s → %s"
                   % (facts.path_raw, facts.path))
    out.append("    pinned Traefik: v%s stable (v3.8-only fields flagged, "
               "not modelled)" % PINNED_TRAEFIK)
    return "\n".join(out) + "\n"


def _router_json(router):
    return {"name": router.name,
            "provider": "internal" if router.is_internal else "file",
            "file": router.file, "line": router.line,
            "kind": router.kind, "rule": router.rule,
            "priority": router.priority,
            "explicit_priority": router.explicit_priority,
            "entrypoints": router.entrypoints,
            "service": router.service_ref,
            "middlewares": list(router.middleware_refs),
            "tls": bool(router.tls is not None),
            "tls_mode": ("passthrough"
                         if router.tls and router.tls.get("passthrough")
                         else ("terminate" if router.tls else "none"))
            if router.kind == "tcp" else None,
            "parentRefs": router.parent_refs,
            "syntax": router.syntax}


def _service_json(svc):
    if svc is None:
        return None
    out = {"name": svc["name"], "kind": svc.get("kind"),
           "provider": svc.get("provider", "file"),
           "type": svc["type"], "servers": svc["servers"],
           "members": svc["members"], "has_servers": svc["has_servers"],
           "effective": svc.get("effective"), "banners": svc["banners"]}
    if svc.get("file"):
        out["file"] = svc["file"]
        out["line"] = svc["line"]
    return out


def render_json(verdict, cfg, facts):
    doc = {"tool": PROG, "version": VERSION,
           "pinned_traefik": PINNED_TRAEFIK,
           "verdict": verdict["verdict"], "exit_code": verdict["exit"]}
    if verdict["verdict"] == "REDIRECT":
        doc["redirect"] = verdict["redirect"]
    if verdict["router"] is not None:
        doc["router"] = _router_json(verdict["router"])
        detail = verdict["detail"]
        doc["service"] = _service_json(verdict["service"])
        doc["middlewares"] = {
            "router": [{"name": m.name, "type": m.type, "file": m.file,
                        "line": m.line, "class": classify_middleware(m)}
                       for m in detail["router_chain"]],
            "service": [{"name": m.name, "type": m.type, "file": m.file,
                         "line": m.line, "class": classify_middleware(m)}
                        for m in detail["service_chain"]],
        }
        doc["rewritten_path"] = detail["rewritten_path"]
        doc["rewrite_steps"] = [
            {"middleware": m.name, "from": old, "to": new}
            for m, old, new in detail["rewrite_steps"]]
        doc["tls_mode"] = detail["tls_mode"]
        doc["banners"] = detail["banners"]
    doc["match_chain"] = [
        {"router": e["router"].name,
         "provider": "internal" if e["router"].is_internal else "file",
         "kind": e["router"].kind, "file": e["router"].file,
         "line": e["router"].line, "priority": e["router"].priority,
         "value": _value_word(e["value"]), "reasons": e["reasons"],
         "flags": e["flags"]} for e in verdict["match_chain"]]
    doc["blockers"] = [
        {"router": b["router"].name, "file": b["router"].file,
         "line": b["router"].line, "reasons": b["reasons"],
         "flags": b.get("flags", [])} for b in verdict["blockers"]]
    doc["findings"] = verdict["findings"]
    doc["coverage"] = verdict["coverage"]
    return json.dumps(doc, indent=2) + "\n"


# ---------------------------------------------------------------- inventory

def list_routers(cfg, kind, quiet):
    rows = []
    for r in cfg.all_routers():
        if kind != "all" and r.kind != kind:
            continue
        rows.append(r)
    rows.sort(key=lambda r: (r.kind, r.name))
    if quiet:
        return "\n".join(_router_label(r) for r in rows) + ("\n" if rows else "")
    out = []
    for r in rows:
        prio = r.priority if r.priority is not None else "?"
        line = "%s %s %s (priority %s" % (
            r.kind, _router_label(r), r.where, prio)
        if r.explicit_priority not in (None, 0):
            line += ", explicit %d" % r.explicit_priority
        line += ")"
        if r.rule:
            line += " rule: %s" % r.rule
        else:
            line += " [udp-no-rule]"
        if r.entrypoints:
            line += " entrypoints: %s" % ",".join(r.entrypoints)
        if r.service_ref:
            line += " service: %s" % r.service_ref
        if r.middleware_refs:
            line += " middlewares: %s" % ",".join(r.middleware_refs)
        if r.tls is not None:
            line += " tls: %s" % (
                "passthrough" if r.tls.get("passthrough") else "terminate")
        if r.parent_refs:
            line += " parentRefs: %s [multi-layer-router-excluded]" % \
                ",".join(r.parent_refs)
        if r.syntax == "v2":
            line += " [v2-rule-syntax-deprecated]"
        if r.templated:
            line += " [go-template-not-evaluated]"
        out.append(line)
    if not out:
        out.append("(no routers)")
    return "\n".join(out) + "\n"


def list_services(cfg, kind, quiet):
    rows = []
    for (k, _name), s in sorted(cfg.services.items()):
        if kind and k != kind:
            continue
        rows.append(s)
    if quiet:
        return "\n".join("%s/%s" % (s.kind, s.name) for s in rows) + \
            ("\n" if rows else "")
    out = []
    for s in rows:
        rep = service_servers(cfg, s)
        if s.type == "loadBalancer":
            detail = "servers: %s" % (
                ", ".join(rep["servers"]) if rep["servers"] else "(none)")
        else:
            detail = "members: %s" % ", ".join(
                str(m["ref"]) for m in rep["members"])
        line = "%s %s@file %s (%s) — %s" % (
            s.kind, s.name, s.where, s.type, detail)
        if s.middlewares:
            line += " middlewares: %s" % ",".join(s.middlewares)
        if s.templated:
            line += " [go-template-not-evaluated]"
        out.append(line)
    if not out:
        out.append("(no services)")
    return "\n".join(out) + "\n"


def list_middlewares(cfg, quiet):
    counts = {}
    for r in cfg.all_routers():
        for ref in r.middleware_refs:
            name, _p = split_provider_ref(ref, r.where, "middleware")
            counts.setdefault(name, {"routers": [], "services": []})
            counts[name]["routers"].append(r.name)
    for s in cfg.services.values():
        for ref in s.middlewares:
            name, _p = split_provider_ref(ref, s.where, "middleware")
            counts.setdefault(name, {"routers": [], "services": []})
            counts[name]["services"].append(s.name)
    # chains reference middlewares too
    for m in cfg.middlewares.values():
        if m.type == "Chain":
            for ref in _as_list(m.config.get("middlewares"), m.where,
                                "chain middlewares"):
                name, _p = split_provider_ref(ref, m.where, "middleware")
                counts.setdefault(name, {"routers": [], "services": []})
    rows = sorted(cfg.middlewares.values(), key=lambda m: m.name)
    if quiet:
        return "\n".join(m.name for m in rows) + ("\n" if rows else "")
    out = []
    for m in rows:
        c = counts.get(m.name, {"routers": [], "services": []})
        refs = []
        if c["routers"]:
            refs.append("routers: %s" % ",".join(sorted(set(c["routers"]))))
        if c["services"]:
            refs.append("services: %s" % ",".join(sorted(set(c["services"]))))
        line = "%s %s (%s) — %s" % (
            m.name, m.where, m.type,
            "; ".join(refs) if refs else "unreferenced")
        if m.type in V38_ONLY_MIDDLEWARES:
            line += " [v3.8-only]"
        elif m.type not in HTTP_BUILTIN_MIDDLEWARES and \
                m.type not in TCP_BUILTIN_MIDDLEWARES:
            line += " [unknown-middleware-type]"
        out.append(line)
    if not out:
        out.append("(no middlewares)")
    return "\n".join(out) + "\n"


