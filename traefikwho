traefik.yaml / traefik.toml at the top of --conf is read as the
static file instead. No auto-discovery of /etc/traefik.

A request field the flags cannot express is UNKNOWN, not absent:
omit --method and a Method(...) term is UNKNOWN, not FALSE. The
verdict names the flag that would resolve it.

Verdicts and exit codes: MATCH 0, REDIRECT 0, NO-MATCH 1 (live
answer: 404), UNKNOWN 2, config-fatal 2, usage error 2.

Semantics pinned to Traefik v3.7 stable (see README.md). The file
provider is the only provider read; Docker/Kubernetes/Consul/etc.
routers are invisible and bannered, never approximated.
"""


def _parse_kv(flag, value, what):
    if "=" not in value:
        raise UsageError("%s %r must be K=V" % (flag, value))
    key, val = value.split("=", 1)
    if not key:
        raise UsageError("%s %r must be K=V" % (flag, value))
    return key, val


def _parse_flags(args, spec):
    """Hand-rolled flag parser. spec: {flag: (kind, dest)} where kind
    is 'bool', 'value', 'multi', 'kv'. Returns (opts, errors)."""
    opts = {"headers": {}, "query": {}}
    i = 0
    while i < len(args):
        arg = args[i]
        if arg not in spec:
            raise UsageError("unknown flag %r" % arg)
        kind, dest = spec[arg]
        if kind == "bool":
            opts[dest] = True
            i += 1
        else:
            if i + 1 >= len(args):
                raise UsageError("flag %s needs a value" % arg)
            val = args[i + 1]
            i += 2
            if kind == "value":
                if dest in opts and opts[dest] is not None:
                    raise UsageError("flag %s given twice" % arg)
                opts[dest] = val
            elif kind == "multi":
                opts.setdefault(dest, []).append(val)
            elif kind == "kv":
                key, v = _parse_kv(arg, val, dest)
                opts[dest].setdefault(key, []).append(v)
    return opts


_COMMON_SPEC = {
    "--conf": ("value", "conf"),
    "--static": ("value", "static"),
    "--json": ("bool", "json"),
    "--quiet": ("bool", "quiet"),
    "--version": ("bool", "version"),
    "--help": ("bool", "help"),
    "-h": ("bool", "help"),
}

_HTTP_SPEC = dict(_COMMON_SPEC)
_HTTP_SPEC.update({
    "--host": ("value", "host"),
    "--path": ("value", "path"),
    "--method": ("value", "method"),
    "--header": ("kv", "headers"),
    "--query": ("kv", "query"),
    "--client-ip": ("value", "client_ip"),
    "--entrypoint": ("value", "entrypoint"),
    "--tls": ("bool", "tls"),
    "--no-tls": ("bool", "no_tls"),
})

_TCP_SPEC = dict(_COMMON_SPEC)
_TCP_SPEC.update({
    "--sni": ("value", "sni"),
    "--alpn": ("value", "alpn"),
    "--client-ip": ("value", "client_ip"),
    "--entrypoint": ("value", "entrypoint"),
    "--tls": ("bool", "tls"),
    "--no-tls": ("bool", "no_tls"),
})

_LIST_SPEC = dict(_COMMON_SPEC)
_LIST_SPEC.update({
    "--list-routers": ("bool", "list_routers"),
    "--list-services": ("bool", "list_services"),
    "--list-middlewares": ("bool", "list_middlewares"),
    "--kind": ("value", "kind"),
})


def _check_version_help(opts):
    if opts.get("version"):
        print("%s %s" % (PROG, VERSION))
        return 0
    if opts.get("help"):
        print(HELP.format(version=VERSION), end="")
        return 0
    return None


def _need_conf(opts):
    conf = opts.get("conf")
    if not conf:
        raise UsageError("--conf is required (no default: Traefik "
                         "configs live in too many places to guess)")
    return conf


def _load_or_fatal(conf, static):
    findings = []
    try:
        return load_config(conf, static, findings)
    except ConfigFatal as exc:
        where = (" at %s" % exc.where) if exc.where else ""
        print("config error: %s%s" % (exc.message, where), file=sys.stderr)
        return None


def main(argv=None):
    args = list(sys.argv[1:] if argv is None else argv)
    try:
        if not args:
            print(HELP.format(version=VERSION), end="")
            return 2
        first = args[0]
        if first in ("--help", "-h"):
            print(HELP.format(version=VERSION), end="")
            return 0
        if first == "--version":
            print("%s %s" % (PROG, VERSION))
            return 0
        if first in ("http", "tcp"):
            spec = _HTTP_SPEC if first == "http" else _TCP_SPEC
            opts = _parse_flags(args[1:], spec)
            done = _check_version_help(opts)
            if done is not None:
                return done
            if opts.get("tls") and opts.get("no_tls"):
                raise UsageError("--tls and --no-tls are mutually "
                                 "exclusive")
            conf = _need_conf(opts)
            cfg = _load_or_fatal(conf, opts.get("static"))
            if cfg is None:
                return 2
            tls = True if opts.get("tls") else (
                False if opts.get("no_tls") else None)
            if first == "http":
                facts = HttpFacts(
                    host=opts.get("host"),
                    path=opts.get("path", "/"),
                    method=opts.get("method"),
                    headers=opts.get("headers"),
                    query=opts.get("query"),
                    client_ip=opts.get("client_ip"),
                    entrypoint=opts.get("entrypoint"), tls=tls)
                verdict = http_verdict(cfg, facts)
            else:
                facts = TcpFacts(
                    sni=opts.get("sni"), alpn=opts.get("alpn"),
                    client_ip=opts.get("client_ip"),
                    entrypoint=opts.get("entrypoint"), tls=tls)
                verdict = tcp_verdict(cfg, facts)
            if opts.get("json"):
                sys.stdout.write(render_json(verdict, cfg, facts))
            else:
                sys.stdout.write(render_text(
                    verdict, cfg, facts, bool(opts.get("quiet"))))
            return verdict["exit"]
        if first.startswith("--list-") or first in (
                "--kind", "--conf", "--static", "--json", "--quiet",
                "--version"):
            opts = _parse_flags(args, _LIST_SPEC)
            done = _check_version_help(opts)
            if done is not None:
                return done
            modes = [m for m in ("list_routers", "list_services",
                                 "list_middlewares") if opts.get(m)]
            if len(modes) != 1:
                raise UsageError("exactly one of --list-routers, "
                                 "--list-services, --list-middlewares is "
                                 "required")
            conf = _need_conf(opts)
            cfg = _load_or_fatal(conf, opts.get("static"))
            if cfg is None:
                return 2
            kind = opts.get("kind")
            quiet = bool(opts.get("quiet"))
            if modes[0] == "list_routers":
                if kind is None:
                    kind = "all"
                if kind not in ("http", "tcp", "all"):
                    raise UsageError("--kind for --list-routers must be "
                                     "http, tcp, or all")
                sys.stdout.write(list_routers(cfg, kind, quiet))
            elif modes[0] == "list_services":
                if kind is not None and kind not in ("http", "tcp"):
                    raise UsageError("--kind for --list-services must be "
                                     "http or tcp")
                sys.stdout.write(list_services(cfg, kind, quiet))
            else:
                if kind is not None:
                    raise UsageError("--kind does not apply to "
                                     "--list-middlewares")
                sys.stdout.write(list_middlewares(cfg, quiet))
            return 0
        if first.startswith("--"):
            raise UsageError("unknown flag %r" % first)
        raise UsageError("unknown verb %r (expected http, tcp, "
                         "--list-routers, --list-services, "
                         "--list-middlewares, --version, --help)" % first)
    except UsageError as exc:
        print("usage error: %s" % exc, file=sys.stderr)
        print("usage: traefikwho http|tcp ... | --list-routers | "
              "--list-services | --list-middlewares | --version | --help",
              file=sys.stderr)
        return 2
    except ConfigFatal as exc:
        where = (" at %s" % exc.where) if exc.where else ""
        print("config error: %s%s" % (exc.message, where), file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
